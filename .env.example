# ---- Device / performance ----
DEVICE=auto                # auto | cpu | cuda
BATCH_SIZE=8
MAX_SEQUENCE_LENGTH=128
FRAME_RATE=2                # frames per second sampled from video
CONTEXT_WINDOW=8            # number of previous utterances used as context

# ---- Model checkpoints (HuggingFace hub IDs, override to swap models) ----
TEXT_MODEL_NAME=roberta-base
WHISPER_MODEL_SIZE=base     # tiny|base|small|medium|large-v3

# ---- Optional: required only for pyannote.audio speaker diarization ----
HUGGINGFACE_TOKEN=

# ---- Paths (all relative to project root unless absolute) ----
DATA_DIR=./dataset/meld
MODEL_DIR=./models
LOG_DIR=./logs
TMP_DIR=./tmp

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Demo mode ----
# When true and no trained checkpoint is found, the pipeline runs in a clearly
# labeled DEMO mode (untrained weights) for UI testing only. Never used to
# report research results.
ALLOW_DEMO_MODE=true
